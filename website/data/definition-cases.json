{
  "schemaVersion": "CapabilityGraphDefinitionCasesV1",
  "cases": [
    { "id": "DEF-PROVIDER-01", "target": "provider", "field": "complete record", "mutation": "provider-valid-minimal", "expect": "success", "description": "最小 Provider 定义可打开" },
    { "id": "DEF-PROVIDER-02", "target": "provider", "field": "providerId", "mutation": "provider-missing-id", "expect": "CG_VALIDATION_FAILED", "description": "缺少 providerId 被拒绝" },
    { "id": "DEF-PROVIDER-03", "target": "provider", "field": "providerId", "mutation": "provider-invalid-id", "expect": "CG_IDENTITY_INVALID", "description": "非法 Provider ID 被拒绝" },
    { "id": "DEF-PROVIDER-04", "target": "provider", "field": "name", "mutation": "provider-empty-name", "expect": "CG_VALIDATION_FAILED", "description": "空 name 被拒绝" },
    { "id": "DEF-PROVIDER-05", "target": "provider", "field": "version", "mutation": "provider-empty-version", "expect": "CG_VALIDATION_FAILED", "description": "空 version 被拒绝" },
    { "id": "DEF-PROVIDER-06", "target": "provider", "field": "specification", "mutation": "provider-invalid-specification", "expect": "CG_VALIDATION_FAILED", "description": "不完整 Specification 被拒绝" },
    { "id": "DEF-PROVIDER-07", "target": "provider", "field": "providerId", "mutation": "provider-config-mismatch", "expect": "CG_VALIDATION_FAILED", "description": "定义与配置 Provider ID 不一致时拒绝" },
    { "id": "DEF-PROVIDER-08", "target": "provider", "field": "specification.entryRef", "mutation": "provider-valid-specification", "expect": "success", "description": "有效 Specification metadata 与相对入口可打开" },
    { "id": "DEF-CAP-01", "target": "capability", "field": "complete record", "mutation": "capability-valid-minimal", "expect": "success", "description": "最小能力定义可打开" },
    { "id": "DEF-CAP-02", "target": "capability", "field": "capabilityId", "mutation": "capability-missing-id", "expect": "CG_VALIDATION_FAILED", "description": "缺少 capabilityId 被拒绝" },
    { "id": "DEF-CAP-03", "target": "capability", "field": "capabilityId", "mutation": "capability-invalid-id", "expect": "CG_IDENTITY_INVALID", "description": "非法 Capability ID 被拒绝" },
    { "id": "DEF-CAP-04", "target": "capability", "field": "capabilityId", "mutation": "capability-duplicate-id", "expect": "CG_VALIDATION_FAILED", "description": "Provider 内重复 ID 被拒绝" },
    { "id": "DEF-CAP-05", "target": "capability", "field": "name", "mutation": "capability-missing-name", "expect": "CG_VALIDATION_FAILED", "description": "缺少 name 被拒绝" },
    { "id": "DEF-CAP-06", "target": "capability", "field": "description", "mutation": "capability-missing-description", "expect": "CG_VALIDATION_FAILED", "description": "缺少 description 被拒绝" },
    { "id": "DEF-CAP-07", "target": "capability", "field": "whenToUse", "mutation": "capability-missing-when", "expect": "CG_VALIDATION_FAILED", "description": "缺少 whenToUse 被拒绝" },
    { "id": "DEF-CAP-08", "target": "capability", "field": "optional arrays", "mutation": "capability-defaults", "expect": "success", "description": "省略可选字段时使用空集合默认值" },
    { "id": "DEF-CAP-09", "target": "capability", "field": "parents", "mutation": "capability-missing-endpoint", "expect": "CG_VALIDATION_FAILED", "description": "不存在的关系端点被拒绝" },
    { "id": "DEF-CAP-10", "target": "capability", "field": "parents", "mutation": "capability-parent-cycle", "expect": "CG_RELATION_CYCLE", "description": "parents 环被拒绝" },
    { "id": "DEF-CAP-11", "target": "capability", "field": "specializes", "mutation": "capability-specializes-cycle", "expect": "CG_RELATION_CYCLE", "description": "specializes 环被拒绝" },
    { "id": "DEF-CAP-12", "target": "capability", "field": "related", "mutation": "capability-cross-provider", "expect": "CG_RELATION_CROSS_PROVIDER", "description": "跨 Provider 关系表示被拒绝" },
    { "id": "DEF-CAP-13", "target": "capability", "field": "knowledge", "mutation": "capability-invalid-knowledge", "expect": "CG_VALIDATION_FAILED", "description": "不完整知识引用被拒绝" },
    { "id": "DEF-CAP-14", "target": "capability", "field": "knowledge.knowledgeId", "mutation": "capability-duplicate-knowledge", "expect": "CG_VALIDATION_FAILED", "description": "顶层重复 knowledgeId 被拒绝" },
    { "id": "DEF-CAP-15", "target": "capability", "field": "knowledge.locator.path", "mutation": "capability-path-traversal", "expect": "CG_PATH_TRAVERSAL", "description": "越界相对路径被拒绝" },
    { "id": "DEF-CAP-16", "target": "capability", "field": "record bytes", "mutation": "capability-oversized", "expect": "CG_BUDGET_EXCEEDED", "description": "超过定义文件字节预算时拒绝" }
  ]
}
