{
  "compilerOptions": {
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2022",
    "strict": true,
    "types": [
      "node"
    ],
    "skipLibCheck": true,
    "allowJs": true
  },
  "include": [
    "rspress.config.ts",
    "theme/**/*.tsx",
    "theme/**/*.ts"
  ]
}
