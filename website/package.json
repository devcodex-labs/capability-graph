{
  "name": "@devcodex-labs/capability-graph-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "npm run generate && rspress dev",
    "build": "npm run generate && npm run check:content && npm run check:reference && npm run check:examples && rspress build",
    "build:site": "rspress build",
    "prebuild:ai": "npm run generate",
    "build:ai": "node scripts/build-ai.mjs",
    "preview": "rspress preview",
    "pregenerate": "npm --prefix .. run build",
    "generate": "node scripts/generate.mjs",
    "check:content": "node scripts/check-content.mjs",
    "check:reference": "node scripts/check-reference-coverage.mjs",
    "check:examples": "node scripts/check-examples.mjs",
    "check:package": "node scripts/check-package-boundary.mjs",
    "check:build": "node scripts/check-build-output.mjs",
    "test:site": "playwright test",
    "check": "npm run build && npm run check:build && npm run test:site && npm run check:package"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@rspress/core": "2.0.22",
    "@rspress/plugin-sitemap": "2.0.22",
    "typescript": "5.9.2"
  }
}
