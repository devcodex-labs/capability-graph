{
  "name": "@devcodex/capability-graph",
  "version": "2.1.0",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/devcodex-labs/capability-graph.git"
  },
  "keywords": [
    "capability-graph",
    "mcp",
    "ai",
    "provider",
    "dependency-graph"
  ],
  "homepage": "https://devcodex-labs.github.io/capability-graph/",
  "bugs": {
    "url": "https://github.com/devcodex-labs/capability-graph/issues"
  },
  "files": [
    "dist",
    "plugin",
    "examples",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "changelogs"
  ],
  "description": "Discover declared capabilities, evaluate applicability and resolve dependencies for applications and AI hosts.",
  "type": "module",
  "bin": {
    "capability-graph": "./dist/cli/main.js"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "types": "./dist/index.d.ts",
  "exports": {
    "./tools": {
      "types": "./dist/tools/index.d.ts",
      "import": "./dist/tools/index.js"
    },
    "./mcp": {
      "types": "./dist/mcp/index.d.ts",
      "import": "./dist/mcp/index.js"
    },
    "./adapters/openai": {
      "types": "./dist/adapters/openai.d.ts",
      "import": "./dist/adapters/openai.js"
    },
    "./adapters/codex": {
      "types": "./dist/adapters/codex.d.ts",
      "import": "./dist/adapters/codex.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node scripts/test.mjs",
    "test:openai:compat": "node scripts/test-openai-compat.mjs",
    "smoke:package": "node scripts/package-smoke.mjs",
    "release:check": "node scripts/check-release.mjs",
    "release:registry": "node scripts/release-registry.mjs",
    "test:release": "node --test scripts/release.test.mjs",
    "docs:dev": "npm --prefix website run dev",
    "docs:build": "npm --prefix website run build",
    "docs:check": "npm --prefix website run check",
    "docs:examples": "node scripts/check-doc-examples.mjs",
    "docs:browser": "npm --prefix website run check:browser"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "@modelcontextprotocol/server": "2.3.1",
    "ajv": "8.20.0",
    "toml-eslint-parser": "0.10.0",
    "undici": "7.30.1"
  },
  "devDependencies": {
    "@types/node": "20.19.0",
    "openai": "6.49.0",
    "typescript": "5.9.2"
  },
  "peerDependencies": {
    "openai": "^6.49.0 || ^7.39.0"
  },
  "peerDependenciesMeta": {
    "openai": {
      "optional": true
    }
  }
}
